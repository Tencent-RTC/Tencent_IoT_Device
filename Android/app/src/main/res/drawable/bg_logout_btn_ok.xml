<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#F0453B"
                android:endColor="#D93325"
                android:type="linear" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#FF5D3B"
                android:endColor="#E63E2C"
                android:type="linear" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
