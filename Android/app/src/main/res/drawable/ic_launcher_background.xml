<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 主渐变底色：左上深蓝 -> 右下青色，科技感强 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:color="#1D4ED8" android:offset="0.0" />
                <item android:color="#2563EB" android:offset="0.45" />
                <item android:color="#22D3EE" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 左上高光柔化 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="30"
                android:centerY="28"
                android:gradientRadius="80"
                android:type="radial">
                <item android:color="#33FFFFFF" android:offset="0.0" />
                <item android:color="#00FFFFFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 装饰斜线，营造科技纹理 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M-10,80 L80,-10"
        android:strokeColor="#1AFFFFFF"
        android:strokeWidth="1.2" />
    <path
        android:fillColor="#00000000"
        android:pathData="M-10,100 L100,-10"
        android:strokeColor="#14FFFFFF"
        android:strokeWidth="1.2" />
    <path
        android:fillColor="#00000000"
        android:pathData="M20,118 L118,20"
        android:strokeColor="#14FFFFFF"
        android:strokeWidth="1.2" />
</vector>
