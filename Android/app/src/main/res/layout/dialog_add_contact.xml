<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_add_contact_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <!-- 标题 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/add_contact_title"
        android:textColor="@color/contacts_title"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- 类型切换 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_add_contact_type_voip"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_add_contact_type_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="110dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/add_contact_type_voip"
            android:textColor="@color/add_contact_type_chip_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_add_contact_type_iot"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_add_contact_type_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="110dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/add_contact_type_iot"
            android:textColor="@color/add_contact_type_chip_text"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 类型描述（与联系人页提示条样式保持一致） -->
    <LinearLayout
        android:id="@+id/ll_add_contact_type_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_contacts_tip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_home_tip_info" />

        <TextView
            android:id="@+id/tv_add_contact_type_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:letterSpacing="0.01"
            android:lineSpacingExtra="2dp"
            android:text="@string/add_contact_voip_desc"
            android:textColor="@color/contacts_tip_text"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- UserId 标签 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/add_contact_userid_label"
        android:textColor="@color/login_label"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- UserId 输入框 -->
    <EditText
        android:id="@+id/et_add_contact_userid"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_thing_input"
        android:hint="@string/add_contact_voip_hint"
        android:imeOptions="actionNext"
        android:inputType="text"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="@color/thing_input_text"
        android:textColorHint="@color/thing_input_hint"
        android:textSize="14sp" />

    <!-- 备注名标签 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/add_contact_name_label"
        android:textColor="@color/login_label"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- 备注名输入框 -->
    <EditText
        android:id="@+id/et_add_contact_name"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_thing_input"
        android:hint="@string/add_contact_name_hint"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="@color/thing_input_text"
        android:textColorHint="@color/thing_input_hint"
        android:textSize="14sp" />

    <!-- 按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_add_contact_cancel"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_add_contact_cancel"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/add_contact_cancel"
            android:textColor="@color/thing_body_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_add_contact_confirm"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_thing_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/add_contact_confirm"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
