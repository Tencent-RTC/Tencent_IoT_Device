<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_logout_dialog"
    android:elevation="16dp"
    android:orientation="vertical"
    android:paddingTop="24dp"
    android:paddingBottom="16dp"
    android:paddingHorizontal="20dp">

    <!-- 标题 -->
    <TextView
        android:id="@+id/tv_logout_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/detail_logout_confirm_title"
        android:textColor="#1D2129"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- 副标题描述 -->
    <TextView
        android:id="@+id/tv_logout_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/detail_logout_confirm_message"
        android:textColor="#86909C"
        android:textSize="13sp" />

    <!-- 底部两个按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_logout_cancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_logout_btn_cancel"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/detail_logout_confirm_cancel"
            android:textColor="#4E5969"
            android:textSize="15sp" />

        <View
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/btn_logout_ok"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_logout_btn_ok"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/detail_logout_confirm_ok"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
