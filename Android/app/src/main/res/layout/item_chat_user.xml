<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:gravity="end|top"
    android:orientation="horizontal">

    <!-- 气泡 -->
    <TextView
        android:id="@+id/tv_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:background="@drawable/bg_aitalk_bubble_user"
        android:maxWidth="260dp"
        android:paddingHorizontal="@dimen/aitalk_bubble_padding_h"
        android:paddingVertical="@dimen/aitalk_bubble_padding_v"
        android:textColor="@color/aitalk_bubble_user_text"
        android:textSize="@dimen/aitalk_bubble_text_size"
        tools:ignore="RtlSymmetry"
        tools:text="示例用户消息" />

    <!-- 用户头像 -->
    <FrameLayout
        android:layout_width="@dimen/aitalk_avatar_size"
        android:layout_height="@dimen/aitalk_avatar_size"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_aitalk_avatar_user">

        <ImageView
            android:layout_width="@dimen/aitalk_avatar_icon_size"
            android:layout_height="@dimen/aitalk_avatar_icon_size"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_aitalk_user" />
    </FrameLayout>

</LinearLayout>
