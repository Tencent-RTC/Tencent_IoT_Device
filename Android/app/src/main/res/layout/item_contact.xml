<?xml version="1.0" encoding="utf-8"?>
<com.tencent.liteav.iot.demo.widget.SwipeRevealLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipe_contact"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:clipChildren="false">

    <!-- 主内容 -->
    <LinearLayout
        android:id="@+id/ll_contact_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_contact_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_contact_avatar">

            <ImageView
                android:id="@+id/iv_contact_avatar"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_contact_avatar" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_contact_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/contacts_item_name"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="张三" />

                <TextView
                    android:id="@+id/tv_contact_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_contact_tag_voip"
                    android:paddingStart="6dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="1dp"
                    android:textColor="@color/contact_tag_voip_text"
                    android:textSize="10sp"
                    android:visibility="gone"
                    tools:text="VOIP用户"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_contact_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="@color/contacts_item_id"
                android:textSize="12sp"
                tools:text="user_1001" />
        </LinearLayout>
    </LinearLayout>

    <!-- 右侧滑出的删除按钮 -->
    <FrameLayout
        android:layout_width="82dp"
        android:layout_height="match_parent"
        android:paddingStart="10dp"
        android:paddingEnd="0dp">

        <LinearLayout
            android:id="@+id/tv_contact_delete"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_contact_delete"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_contact_delete" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/contacts_delete"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

</com.tencent.liteav.iot.demo.widget.SwipeRevealLayout>
