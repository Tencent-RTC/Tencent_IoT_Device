<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.TXIoTDeviceDemo" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_login_gradient</item>
        <item name="android:statusBarColor">@color/login_bg_start</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 监控页面沉浸式深色主题：内容延伸到状态栏后方，图标为白色 -->
    <style name="Theme.TXIoTDeviceDemo.Monitor" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- Login 页面通用样式 -->
    <style name="LoginLabelRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="LoginLabelIcon">
        <item name="android:layout_width">@dimen/login_icon_size</item>
        <item name="android:layout_height">@dimen/login_icon_size</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="LoginLabelText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/login_label</item>
        <item name="android:textSize">@dimen/login_label_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="LoginRequiredMark">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:textColor">@color/login_required</item>
        <item name="android:textSize">@dimen/login_label_text</item>
    </style>

    <style name="LoginInputContainer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/login_input_height</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/bg_login_input</item>
    </style>

    <style name="LoginEditText" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@null</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:textColor">@color/login_input_text</item>
        <item name="android:textColorHint">@color/login_input_hint</item>
        <item name="android:textSize">@dimen/login_input_text</item>
        <item name="android:singleLine">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:gravity">center_vertical</item>
    </style>
</resources>